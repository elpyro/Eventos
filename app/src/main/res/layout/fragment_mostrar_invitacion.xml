<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MostrarInvitacion">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


    <androidx.cardview.widget.CardView
        android:id="@+id/cardView_invitacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:background="@color/fondo_cardView"
        app:cardBackgroundColor="@color/fondo_cardView"
        app:cardCornerRadius="20dp"
        app:cardElevation="10sp" >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:orientation="vertical">

            <TextView

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
                android:theme="@style/texto_titulo"
                android:text="@string/Felicidades" />

            <TextView
                android:id="@+id/textView_nombreEnInvitacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="@string/Nombre"

                android:theme="@style/texto_sub_titulo" />
            <TextView
                android:id="@+id/textView_descripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/EstasInvitado"
                android:theme="@style/texto_sub_titulo" />

            <TextView
                android:id="@+id/textView_nombre_evento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:gravity="center"
                android:text="@string/Nombre"
                android:textSize="20sp"
                android:textStyle="bold"
                android:theme="@style/texto_cursiva" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:theme="@style/texto_sub_titulo"
                    android:text="@string/Fecha" />

                <TextView
                    android:id="@+id/textView_fecha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:theme="@style/texto_cursiva"
                    android:layout_marginStart="10dp"
                    android:text="@string/Fecha" />
            </LinearLayout>


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginStart="20dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:theme="@style/texto_sub_titulo"
                    android:text="@string/Costo" />

                <TextView
                    android:id="@+id/textView_costo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:theme="@style/texto_cursiva"
                    android:layout_marginStart="10dp"
                    android:text="@string/Costo" />

                <TextView
                    android:id="@+id/textView3"
                    android:layout_marginStart="20dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:theme="@style/texto_cursiva"
                    android:text="@string/Valido" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginStart="20dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:theme="@style/texto_sub_titulo"
                    android:text="@string/Ciudad" />

                <TextView
                    android:id="@+id/textView_ciudad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:theme="@style/texto_cursiva"
                    android:text="@string/Ciudad" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:layout_marginStart="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:theme="@style/texto_sub_titulo"
                    android:text="@string/Direccion" />

                <TextView
                    android:id="@+id/textView_direccion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:theme="@style/texto_cursiva"
                    android:text="@string/Direccion" />
            </LinearLayout>

            <ImageView
                android:layout_marginTop="10dp"
                android:id="@+id/imageView_qr"
                android:layout_width="match_parent"
                android:layout_height="167dp"
                android:src="@drawable/icono_qr"
                android:contentDescription="@string/Imagen" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/button_compartir"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:layout_gravity="center"
        android:background="@drawable/boton"
        android:theme="@style/Botones"
        android:textColor="@color/black"
        android:text="@string/Compartir" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="@string/Ficha"
            android:theme="@style/texto_titulo" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:background="@color/fondo_cardView"
        app:cardBackgroundColor="@color/fondo_cardView"
        app:cardCornerRadius="20dp"
        app:cardElevation="10sp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_marginRight="10dp"
            android:layout_marginLeft="10dp"
            android:orientation="vertical">


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Nombre"
                    android:theme="@style/texto_sub_titulo" />

                <TextView
                    android:id="@+id/textView_nombre_invitado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/Costo"
                    android:theme="@style/texto_plano" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Telefono"
                    android:theme="@style/texto_sub_titulo" />

                <TextView
                    android:id="@+id/textView_telefono_invitado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/Ciudad"
                    android:theme="@style/texto_plano" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Correo"
                    android:theme="@style/texto_sub_titulo" />

                <TextView
                    android:id="@+id/textView_correo_invitado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/Correo"
                    android:theme="@style/texto_plano" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Estado"
                    android:theme="@style/texto_sub_titulo" />

                <TextView
                    android:id="@+id/textView_estado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/Estado"
                    android:theme="@style/texto_plano" />
            </LinearLayout>

            <Button
                android:id="@+id/button_editar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"

                android:theme="@style/Botones"
                android:textColor="@color/black"
                android:text="@string/Editar" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
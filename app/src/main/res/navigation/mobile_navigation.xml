<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/nav_inicio">

    <fragment
        android:id="@+id/nav_inicio"
        android:name="com.example.eventos.ui.home.HomeFragment"
        android:label="@string/Inicio"
        tools:layout="@layout/fragment_home" />
    <fragment
        android:id="@+id/usuarios"
        android:name="com.example.eventos.pantallas.Usuarios"
        android:label="@string/Usuario"
        tools:layout="@layout/fragment_usuarios" >
        <action
            android:id="@+id/action_usuarios_to_lista_Usuarios"
            app:destination="@id/lista_Usuarios" />
    </fragment>

    <fragment
        android:id="@+id/lista_Usuarios"
        android:name="com.example.eventos.pantallas.Lista_Usuarios"
        android:label="@string/ListadeUsuarios"
        tools:layout="@layout/fragment_lista__usuarios" >
        <action
            android:id="@+id/action_lista_Usuarios_to_usuarios"
            app:destination="@id/usuarios" />
    </fragment>
    <activity
        android:id="@+id/pantallaPrincipal"
        android:name="com.example.eventos.PantallaPrincipal"
        android:label="app_bar_main"
        tools:layout="@layout/app_bar_main" />
    <fragment
        android:id="@+id/cerrarSesion"
        android:name="com.example.eventos.CerrarSesion"
        android:label="@string/CerraSesion"
        tools:layout="@layout/fragment_cerrar_sesion" />

</navigation>
<resources xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base application theme. -->

    <style name="Theme.Eventos" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/amarilloFondo</item>
        <item name="colorPrimaryVariant">@color/amarillo</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->

        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>

        <!-- Customize your theme here. -->
        <!-- Los siguientes valors son necesarios para reparar un en el action bar. -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.Eventos.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.Eventos.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.Eventos.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="splah_screem" parent="Theme.Eventos">
        <item name="android:windowBackground">@drawable/splash_screem</item>
    </style>
    <style name="texto_titulo" parent="Theme.Eventos">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="fontFamily">sans-serif-black</item>
    </style>

    <style name="texto_sub_titulo" parent="Theme.Eventos">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_margin">5sp</item>
        <item name="fontFamily">sans-serif-black</item>
    </style>
    <style name="texto_cursiva" parent="Theme.Eventos">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:layout_margin">5sp</item>
        <item name="android:fontFamily">casual</item>
    </style>
    <style name="texto_plano" parent="Theme.Eventos">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:layout_margin">5sp</item>

    </style>
    <style name="Botones"    parent="Theme.AppCompat.Light.NoActionBar">
    <item name="android:background">@drawable/boton</item>
        <item name="android:textSize">14sp</item>
        <item name="colorPrimaryVariant">@color/black</item>
        <item name="colorPrimary">@color/amarillo</item>
    </style>
    <style name="cardViewinvitados" parent="Theme.Eventos">
        <item name="background">@style/cardViewinvitados</item>
    </style>
    <style name="SwichAmarillo" parent="Theme.AppCompat.Light">
        <!-- active thumb & track color (30% transparency) -->
        <item name="colorControlActivated">@color/amarillo</item>

        <!-- inactive thumb color -->
        <item name="colorSwitchThumbNormal">#f1f1f1
        </item>

        <!-- inactive track color (30% transparency) -->
        <item name="android:colorForeground">#42221f1f
        </item>
    </style>
</resources>